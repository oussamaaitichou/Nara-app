# Copia este archivo como .env y rellena los valores. NUNCA subas .env a GitHub.

# ---- Opción A: Gemini gratuito (Google AI Studio) ----
AI_API_KEY=pega_aqui_tu_clave_de_AI_Studio
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash
# Si ese modelo no aparece disponible en tu cuenta, usa el nombre de un modelo Flash que te muestre AI Studio.

# ---- Opción B: xAI (Grok) ----
# AI_API_KEY=tu_clave_de_xai
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.5

# Límite de longitud de cada respuesta (los modelos que "piensan" gastan parte aquí)
# AI_MAX_TOKENS=3000
