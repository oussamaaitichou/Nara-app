# Copia este archivo como .env y rellena los valores. NUNCA subas .env a GitHub.

# ---- Motor de IA (Gemini gratuito, Google AI Studio) ----
AI_API_KEY=pega_aqui_tu_clave_de_AI_Studio
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash
# AI_MAX_TOKENS=3000
# Cuánto "piensa" el modelo antes de escribir: minimal (empieza antes) · low (por defecto con Gemini) · medium · high (más calidad, más espera)
# AI_REASONING_EFFORT=low
# Modelo de reserva: si el principal da error 503 (saturado) o 429 (límite), se prueba este. Elige otro modelo Flash que veas en AI Studio.
# AI_FALLBACK_MODEL=

# ---- Alternativa: xAI (Grok) ----
# AI_API_KEY=tu_clave_de_xai
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.5

# ---- Acceso del piloto por código (opcional; apagado por defecto) ----
# Para activarlo hacen falta las tres variables y una base de datos (DATABASE_URL).
# PILOTO_ACCESO=activo
# SESSION_SECRET=      (texto aleatorio de 32 caracteres o más)
# ADMIN_PASSWORD=      (contraseña del panel /admin, mínimo 8 caracteres)

# ---- Base de datos Postgres (en Vercel se rellena sola al conectar Neon desde Storage) ----
# DATABASE_URL=
